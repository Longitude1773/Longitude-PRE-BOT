# FlexMLS Agent Credentials
FLEXMLS_URL=https://parkcity.flexmls.com
FLEXMLS_USERNAME=
FLEXMLS_PASSWORD=
FLEXMLS_PAUSE_AFTER_STEP4_SECONDS=90
FLEXMLS_SCAN_ENABLED=true
# Hot-sheet scan is gated to this Mountain Time window (DST-aware).
# Start is inclusive, end is exclusive: defaults = 7:00am MT through 6:59:59pm MT.
# Outside the window the watcher stays running for Slack commands but skips the scan.
FLEXMLS_SCAN_WINDOW_START_HOUR=7
FLEXMLS_SCAN_WINDOW_END_HOUR=19
FLEXMLS_STOP_AFTER_STEP4=false
FLEXMLS_STOP_AFTER_HOTSHEET=false
FLEXMLS_STOP_AFTER_PERMALINK=false
ZILLOW_BROWSER_CHANNEL=chrome
ZILLOW_HEADLESS=false
ZILLOW_WARM_URL=https://www.zillow.com/
ZILLOW_BROWSER_RUN_REUSE_SESSION=true
ZILLOW_CAPTCHA_WAIT_MS=180000
ON_DEMAND_REQUEST_LEASE_MS=360000
ON_DEMAND_REQUEST_LEASE_POLL_MS=1000
BROWSER_BACKEND=local
FLEXMLS_BROWSER_BACKEND=local
FLEXMLS_ON_DEMAND_BROWSER_BACKEND=local
FLEXMLS_ON_DEMAND_BROWSER_RUN_REUSE_SESSION=true
ZILLOW_BROWSER_BACKEND=local
CLOUDFLARE_BROWSER_RUN_ACCOUNT_ID=
CLOUDFLARE_BROWSER_RUN_API_TOKEN=
CLOUDFLARE_BROWSER_RUN_KEEP_ALIVE_MS=600000

# AirDNA API
AIRDNA_API_KEY=

# PriceLabs API
PRICELABS_API_KEY=

# Slack Bot
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0XXXXXXX

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
# Optional for older Supabase projects still using the legacy server-side key name:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (PDF storage)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
