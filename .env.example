# FlexMLS Agent Credentials
FLEXMLS_URL=https://parkcity.flexmls.com
FLEXMLS_USERNAME=
FLEXMLS_PASSWORD=
FLEXMLS_PAUSE_AFTER_STEP4_SECONDS=90
FLEXMLS_SCAN_ENABLED=true
# Hot-sheet scan is gated to this Mountain Time window (DST-aware).
# Start is inclusive, end is exclusive: defaults = 7:00am MT through 6:59:59pm MT.
# Outside the window the watcher stays running for Slack commands but skips the scan.
FLEXMLS_SCAN_WINDOW_START_HOUR=7
FLEXMLS_SCAN_WINDOW_END_HOUR=19
FLEXMLS_STOP_AFTER_STEP4=false
FLEXMLS_STOP_AFTER_HOTSHEET=false
FLEXMLS_STOP_AFTER_PERMALINK=false
ZILLOW_BROWSER_CHANNEL=chrome
ZILLOW_HEADLESS=false
ZILLOW_WARM_URL=https://www.zillow.com/
ZILLOW_BROWSER_RUN_REUSE_SESSION=true
ZILLOW_CAPTCHA_WAIT_MS=180000
ON_DEMAND_REQUEST_LEASE_MS=360000
ON_DEMAND_REQUEST_LEASE_POLL_MS=1000
BROWSER_BACKEND=local
FLEXMLS_BROWSER_BACKEND=local
FLEXMLS_ON_DEMAND_BROWSER_BACKEND=local
FLEXMLS_ON_DEMAND_BROWSER_RUN_REUSE_SESSION=true
ZILLOW_BROWSER_BACKEND=local
CLOUDFLARE_BROWSER_RUN_ACCOUNT_ID=
CLOUDFLARE_BROWSER_RUN_API_TOKEN=
CLOUDFLARE_BROWSER_RUN_KEEP_ALIVE_MS=600000

# AirDNA API
AIRDNA_API_KEY=

# PriceLabs API
PRICELABS_API_KEY=

# Slack Bot
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0XXXXXXX

# Public PRE site (agents browse/download completed evals here). Used to build
# the per-property "View on PRE site" link in Slack review posts. No trailing
# slash. Defaults to the live custom domain when unset.
# PRE_SITE_URL=https://evaluations.longitude.network

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
# Optional for older Supabase projects still using the legacy server-side key name:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (PDF storage)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Open-house tracker (scripts/open-house-tracker.ts) — Google Drive/Sheets as the
# signed-in user. Create a "Desktop app" OAuth client, then run scripts/google-auth.ts.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional overrides
# OPEN_HOUSE_TRACKER_FOLDER_ID=1bgsLA7dWRvonPFqvUwStyusaUUV5N_3Z
# OPEN_HOUSE_SLACK_CHANNEL_ID=

# Gateway liveness alert (scripts/app-mention-alert.ts). Needs only
# SLACK_BOT_TOKEN + SLACK_CHANNEL_ID above; everything here is an override.
# APP_MENTION_WATCH_CHANNELS=    # comma-separated channel IDs (default: SLACK_CHANNEL_ID)
# APP_MENTION_ALERT_CHANNEL_ID=  # where alerts post (default: SLACK_CHANNEL_ID)
# APP_MENTION_ALERT_USER_ID=     # user to @mention in alerts, e.g. U05...
# APP_MENTION_GRACE_MINUTES=10        # how long the bot gets to answer before it counts as silent
# APP_MENTION_LOOKBACK_MINUTES=180    # how recent a message must be to be judged
# APP_MENTION_DISCOVERY_MINUTES=20160 # how far back to look for threads (14 days)

# Pipeline stall alert (scripts/pipeline-alert.ts). Also reads the watcher's own
# FLEXMLS_WATCH_INTERVAL_SECONDS / FLEXMLS_SCAN_WINDOW_* / FLEXMLS_SCAN_ENABLED
# so its idea of "late" matches the watcher's schedule.
# PIPELINE_ALERT_CHANNEL_ID=        # where alerts post (default: SLACK_CHANNEL_ID)
# PIPELINE_ALERT_USER_ID=           # who to @mention (default: APP_MENTION_ALERT_USER_ID)
# PIPELINE_ALERT_COOLDOWN_MINUTES=360  # re-alert interval while a fault persists
# PIPELINE_ALERT_STALE_CYCLES=2.5      # heartbeat stale past N watcher cycles
# PIPELINE_ALERT_MIN_SAMPLES=3         # consecutive bad samples before persistence checks fire
