# Longitude STR Bot — Hermes gateway instance
# Copy to .hermes.env and fill in the blanks.

# Path to your Hermes agent checkout (the repo that contains gateway.run)
HERMES_AGENT_DIR=/absolute/path/to/hermes-agent

# Slack app for this dedicated bot
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_ALLOWED_USERS=U07UQ0YUTQQ
SLACK_ALLOW_ALL_USERS=true

# Optional but useful
SLACK_HOME_CHANNEL=C1234567890
SLACK_HOME_CHANNEL_NAME=str-evaluations
SLACK_CHANNEL_ID=C1234567890
SLACK_ALERT_USER_ID=U1234567890

# Runtime
STR_BOT_DIR=/absolute/path/to/str-revenue-bot
SYSTEM_PROMPT_FILE=/absolute/path/to/str-revenue-bot/HERMES.md
LLM_MODEL=anthropic/claude-sonnet-4-6

# Optional: point the managed .hermes-runtime at your live Codex auth file
# Defaults to ~/.codex/auth.json, then ~/.hermes/auth.json
# HERMES_AUTH_FILE=/Users/you/.codex/auth.json
